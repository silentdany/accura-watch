# ─── Required ────────────────────────────────────────────────────────────────
# Postgres (Neon, Supabase, Railway, local…)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth — long random string (openssl rand -base64 32). Also encrypts stored credentials.
BETTER_AUTH_SECRET=
# Public URL of this instance (local: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# Protects /api/cron/collect (Vercel Cron sends it automatically)
CRON_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────
# Restrict the single owner account to this email. Unset = first sign-up becomes owner.
# OWNER_EMAIL=you@example.com

# Separate key for encrypting provider credentials (defaults to BETTER_AUTH_SECRET)
# ENCRYPTION_KEY=

# Google OAuth app → enables the "Connect with Google" button for Search Console.
# Redirect URI: <BETTER_AUTH_URL>/api/integrations/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Provider credentials as env (alternative to Settings UI) ────────────────
# Anything set in Settings overrides these.
# GSC_CLIENT_EMAIL=sa@project.iam.gserviceaccount.com
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# POSTHOG_API_KEY=phx_...
# POSTHOG_HOST=https://eu.posthog.com
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=my-org
# SENTRY_HOST=https://sentry.io
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# DATAFORSEO_LOCATION_CODE=2840
# DATAFORSEO_LANGUAGE_CODE=en
# OPENPAGERANK_API_KEY=
