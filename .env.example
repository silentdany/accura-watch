# Neon / Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Production: https://accura-watch.vercel.app — local: http://localhost:3000
BETTER_AUTH_URL=https://accura-watch.vercel.app

# Solo owner (only this email may sign up / sign in)
OWNER_EMAIL=dany@accura.dev

# Vercel Cron — Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-cron-secret

# Public app URL (Vercel sets VERCEL_URL automatically for previews)
NEXT_PUBLIC_APP_URL=https://accura-watch.vercel.app

# Sentry connector (optional — without these, returns ok:false / not configured)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
