# Neon / Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Production: https://watch.accura.dev — local: http://localhost:3000
BETTER_AUTH_URL=https://watch.accura.dev

# Solo owner (only this email may sign up / sign in)
OWNER_EMAIL=dany@accura.dev

# Vercel Cron — Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-cron-secret

# Public app URL
NEXT_PUBLIC_APP_URL=https://watch.accura.dev

# Sentry connector (optional)
# Org is global; project slug lives on Site.config.sentryProject (brieform, directoryfast).
# SENTRY_AUTH_TOKEN=
SENTRY_ORG=accura-9m
# Optional transitional fallback only (prefer Site.config.sentryProject):
# SENTRY_PROJECT=

# Google Search Console connector (optional — scaffold skips without these)
# Service account email + PEM private key (preferred for Vercel; not a JSON blob).
# Grant the SA access to each GSC property; set Site.config.gscSiteUrl per site.
# GSC_CLIENT_EMAIL=watch-collector@PROJECT.iam.gserviceaccount.com
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# OAuth user consent flow is out of scope for V1 scaffold.

# Ahrefs Domain Rating free (optional — skips without key)
# Free APIv3 key → GET /v3/public/domain-rating-free (no API units).
# Target = hostname derived from Site.url (no Site.config id).
# AHREFS_API_KEY=
