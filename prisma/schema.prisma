// Accura Watch — open-source, MCP-native multi-site dashboard
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Better Auth (standard schema) ──────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Sites & data ───────────────────────────────────────────────────────────

/// A watched site. Created from the UI, the MCP server or a Search Console import.
model Site {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  /// Bare hostname without www (e.g. example.com). Used for SEO + health.
  domain           String   @unique
  url              String
  /// Search Console property, e.g. "sc-domain:example.com" or "https://example.com/"
  gscProperty      String?
  /// PostHog project id (numeric, stored as string)
  posthogProjectId String?
  /// Optional $host filter when a PostHog project tracks several sites
  posthogHost      String?
  /// Sentry project slug inside the configured org
  sentryProject    String?
  pinned           Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  metrics      DailyMetric[]
  insights     Insight[]
  healthChecks HealthCheck[]
  syncStates   SyncState[]

  @@index([active])
}

/// One value per site/source/key/day (GSC clicks, PostHog visitors, Sentry events, SEO rank...)
model DailyMetric {
  id     String   @id @default(cuid())
  siteId String
  site   Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  source String
  key    String
  date   DateTime @db.Date
  value  Float

  @@unique([siteId, source, key, date])
  @@index([date])
}

/// Latest structured payload per site/source/kind (top queries, top issues, period summaries...)
model Insight {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  source    String
  kind      String
  data      Json
  updatedAt DateTime @updatedAt

  @@unique([siteId, source, kind])
}

model HealthCheck {
  id           String    @id @default(cuid())
  siteId       String
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  checkedAt    DateTime  @default(now())
  ok           Boolean
  statusCode   Int?
  latencyMs    Int?
  sslExpiresAt DateTime?
  error        String?

  @@index([siteId, checkedAt])
}

/// Last run of each collector for each site (drives cadence + error display)
model SyncState {
  id            String    @id @default(cuid())
  siteId        String
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  source        String
  lastRunAt     DateTime
  lastSuccessAt DateTime?
  ok            Boolean
  error         String?

  @@unique([siteId, source])
}

/// Credentials for a data provider. `secret` is AES-256-GCM encrypted JSON.
model Integration {
  provider  String   @id
  config    Json?
  secret    String?
  updatedAt DateTime @updatedAt
}

/// Personal access tokens for the MCP server and REST API (sha256-hashed)
model ApiToken {
  id         String    @id @default(cuid())
  name       String
  prefix     String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}
