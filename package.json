    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:sync": "node scripts/db-sync.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "better-auth": "^1.3.8",
    "lucide-react": "^0.544.0",
